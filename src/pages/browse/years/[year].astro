---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import BrowseTabs from "@/components/BrowseTabs.astro";
import BrowseList from "@/components/BrowseList.astro";
import { getPrimaryPosts, getPrimaryNotes, getPrimaryEntries } from "@/utils/content";
import { getYears, filterByYear } from "@/utils/browse";
import { getAssetPath } from "@/utils/url";

export async function getStaticPaths() {
  const allEntries = await getPrimaryEntries();
  const years = getYears(allEntries);

  return years.map((year) => ({
    params: { year },
  }));
}

const { year } = Astro.params;

const allEntries = await getPrimaryEntries();
const allPosts = await getPrimaryPosts();
const allNotes = await getPrimaryNotes();
---

<BaseLayout title={`${year} · Browse`}>
  <div class="layout-content">
    <a
      href={getAssetPath("browse/years")}
      class="font-mono text-xs uppercase tracking-wide text-clay hover:underline"
    >
      ← Years
    </a>

    <PageHeader eyebrow=" Browse — Year" title={year} />

    <BrowseTabs defaultTab="all">
      <Fragment slot="all">
        <BrowseList entries={filterByYear(allEntries, year)} />
      </Fragment>
      <Fragment slot="essays">
        <BrowseList entries={filterByYear(allPosts, year)} />
      </Fragment>
      <Fragment slot="notes">
        <BrowseList entries={filterByYear(allNotes, year)} />
      </Fragment>
    </BrowseTabs>
  </div>
</BaseLayout>
